{
  "name": "my-resume",
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node ./generate-build-info.js",
    "deploy": "npm run prebuild && pnpm generate:cv && ng deploy --base-href=/my-resume/",
    "generate:cv": "tsx scripts/generate-cv-pdf.mts",
    "prebuild": "node ./generate-build-info.js",
    "prestart": "node ./generate-build-info.js",
    "start": "ng serve --port 4202",
    "build": "ng build",
    "prewatch": "node ./generate-build-info.js",
    "watch": "ng build --watch --configuration development",
    "pretest": "node ./generate-build-info.js",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "coverage": "ng test --watch=false --coverage",
    "coverage:watch": "ng test --watch --coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^26.4.0",
    "angular-cli-ghpages": "^2.0.3",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  }
}
